# AWS Credentials for Amazon Bedrock
# Note: For local testing, if you don't have AWS credentials yet,
# the backend automatically runs in Mock/Simulation Mode so you and your team can test right away!

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
# AWS_SESSION_TOKEN=optional_session_token_if_using_temporary_credentials

# Bedrock Model ID
# Options:
# anthropic.claude-3-5-sonnet-20240620-v1:0 (Highest accuracy, smart reasoning)
# anthropic.claude-3-haiku-20240307-v1:0   (Lowest latency, cost efficient)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Server settings
PORT=8000
HOST=0.0.0.0
USE_MOCK_BEDROCK=false
